#!/bin/bash

# ==========================================================
# TACE Environment Restore
#
# USE:
#     source restartAll.scr
#
# or
#
#     . ./restartAll.scr
#
# ==========================================================

# Prevent accidental execution
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo
    echo "Run this script with:"
    echo
    echo "    source restartAll.scr"
    echo
    exit 1
fi

set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "========================================="
echo " Restoring TACE Development Environment"
echo "========================================="

#
# 1. Load environment variables
#

if [ -f "$HOME/.profile" ]; then
    source "$HOME/.profile"
fi

#
# 2. Activate Python virtual environment
#

if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
    echo "✓ Python virtual environment activated."
else
    echo "✗ ERROR: .venv not found."
    return 1
fi

#
# 3. Verify NOTION_TOKEN
#

if [ -z "${NOTION_TOKEN:-}" ]; then
    echo "✗ ERROR: NOTION_TOKEN is not defined."
    return 1
fi

echo "✓ NOTION_TOKEN loaded."

#
# 4. Verify mdsync
#

if ! command -v mdsync >/dev/null 2>&1; then
    echo "Installing mdsync..."
    pip install mdsync
fi

if ! command -v mdsync >/dev/null 2>&1; then
    echo "✗ ERROR: mdsync installation failed."
    return 1
fi

echo "✓ $(mdsync --version)"

#
# 5. Verify Docker / Podman
#

if ! command -v docker >/dev/null 2>&1; then
    echo "✗ ERROR: docker command not found."
    return 1
fi

echo "✓ Docker/Podman installed."

#
# 6. Verify container engine
#

if ! docker info >/dev/null 2>&1; then
    echo "✗ ERROR: Container engine is not running."
    return 1
fi

echo "✓ Container engine running."

#
# 7. Verify Ollama
#

if curl -fs http://localhost:11434/api/tags >/dev/null; then
    echo "✓ Ollama running."
else
    echo "✗ ERROR: Ollama is not running."
    echo
    echo "Start it with:"
    echo "    ollama serve"
    return 1
fi

#
# 8. Verify pretace container
#

if docker ps --format '{{.Names}}' | grep -qx pretace; then

    echo "✓ pretace container already running."

elif docker ps -a --format '{{.Names}}' | grep -qx pretace; then

    echo "Starting pretace container..."
    docker start pretace >/dev/null

    echo "✓ pretace container started."

else

    echo "Creating pretace container..."

    docker run -d \
        --name pretace \
        --restart unless-stopped \
        -p 8000:8000 \
        --add-host=host.docker.internal:host-gateway \
        -e OLLAMA_BASE_URL=http://host.docker.internal:11434 \
        -v "$PWD:/app" \
        pretace-tace:latest >/dev/null

    echo "✓ pretace container created."

fi

#
# 9. Verify API
#

sleep 2

if curl -fs http://localhost:8000/ui >/dev/null; then
    echo "✓ TACE server responding."
else
    echo "⚠ TACE server not responding yet."
fi

echo
echo "========================================="
echo " TACE environment is ready."
echo "========================================="
echo

echo "Python : $(which python)"
echo "Pip    : $(which pip)"
echo "mdsync : $(which mdsync)"

if [ -n "${VIRTUAL_ENV:-}" ]; then
    echo
    echo "✓ Virtual environment:"
    echo "  $VIRTUAL_ENV"
fi
